# Default free provider: groq | huggingface | openai | mock
# Leave blank to auto-detect from whichever API key is set.
LLM_PROVIDER=groq

# --- Groq (recommended free tier) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# --- Hugging Face Inference (free tier) ---
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest

# --- OpenAI (optional paid) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Set to 1 to skip the LLM and return deterministic stub answers (retrieval still runs)
RAG_MOCK_LLM=0

# Optional override for config.yaml paths
RAG_CONFIG=config.yaml
